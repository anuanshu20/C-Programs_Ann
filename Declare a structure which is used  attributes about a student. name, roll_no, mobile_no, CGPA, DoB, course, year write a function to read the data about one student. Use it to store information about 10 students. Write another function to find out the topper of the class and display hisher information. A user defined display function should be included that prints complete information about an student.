    Student topper;
    for(int i = 0; i < SIZE; i++) {
        printf("\nEnter details of student %d:", i + 1);
        input(&students[i]);
    }
    topper = findTopper(students, SIZE);
    printf("Topper of the class:");
    display(topper);
    return 0;
}
