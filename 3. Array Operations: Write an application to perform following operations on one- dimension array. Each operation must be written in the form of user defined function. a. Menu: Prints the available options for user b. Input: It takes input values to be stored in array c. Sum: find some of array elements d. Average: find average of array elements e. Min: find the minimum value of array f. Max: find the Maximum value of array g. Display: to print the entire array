#include <stdio.h>

#define SIZE 100

void menu();
void input(int arr[], int *n);
int sum(int arr[], int n);
float average(int arr[], int n);
int minimum(int arr[], int n);
int maximum(int arr[], int n);
void display(int arr[], int n);

int main() {
    int arr[SIZE], n = 0, choice;

    while(1) {
        menu();
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                input(arr, &n);
                break;

            case 2:
                printf("Sum = %d\n", sum(arr, n));
                break;

            case 3:
                printf("Average = %.2f\n", average(arr, n));
                break;

            case 4:
                printf("Minimum = %d\n", minimum(arr, n));
                break;

            case 5:
                printf("Maximum = %d\n", maximum(arr, n));
                break;

            case 6:
                display(arr, n);
                break;

            case 7:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}

void menu() {
    printf("\n===== ARRAY OPERATIONS MENU =====\n");
    printf("1. Input Array\n");
    printf("2. Sum of Elements\n");
    printf("3. Average of Elements\n");
    printf("4. Minimum Element\n");
    printf("5. Maximum Element\n");
    printf("6. Display Array\n");
    printf("7. Exit\n");
}

void input(int arr[], int *n) {
    printf("Enter number of elements: ");
    scanf("%d", n);

    printf("Enter elements:\n");
    for(int i = 0; i < *n; i++) {
        scanf("%d", &arr[i]);
    }
}

int sum(int arr[], int n) {
    int s = 0;
    for(int i = 0; i < n; i++) {
        s += arr[i];
    }
    return s;
}

float average(int arr[], int n) {
    if(n == 0) return 0;
    return (float)sum(arr, n) / n;
}

int minimum(int arr[], int n) {
    int min = arr[0];
    for(int i = 1; i < n; i++) {
        if(arr[i] < min)
            min = arr[i];
    }
    return min;
}

int maximum(int arr[], int n) {
    int max = arr[0];
    for(int i = 1; i < n; i++) {
        if(arr[i] > max)
            max = arr[i];
    }
    return max;
}

void display(int arr[], int n) {
    printf("Array elements:\n");
    for(int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}
